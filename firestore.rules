rules_version = '2';

// Roles:
//  - admin:  todo.
//  - asesor: sus propiedades y sus leads (los que tienen su agentId).
//  - socio:  un dueño (propietario o colaborador) en su panel: su resumen y sus casas; cambia solo las de por noche.
//  - público: lee contenido publicado y puede crear leads desde los formularios.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.activo == true
        && userDoc().data.rol in ['admin', 'asesor'];
    }
    // Dueño (propietario o colaborador; rol «socio»): entra al panel solo a lo suyo, el de la ficha que le dio acceso.
    function esSocio() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.activo == true
        && userDoc().data.rol == 'socio';
    }
    function esSocioDe(casa) {
      return esSocio() && casa.get('propietarioId', '') != '' && casa.propietarioId == userDoc().data.propietarioId;
    }
    // Lo que el dueño cambia o lee en privado es solo de sus casas por noche; las de venta y renta las lleva el equipo.
    function esSocioPorNoche(casa) {
      return esSocioDe(casa) && casa.get('operacion', '') == 'vacacional';
    }
    // Lo mismo, por el id de la casa (reservas, solicitudes y chats llevan el propertyId).
    // (Un registro viejo sin propertyId, o una casa que no existe, niega sin error.)
    function esSocioDeCasaPorNoche(propertyId) {
      return propertyId is string && propertyId != ''
        && exists(/databases/$(database)/documents/properties/$(propertyId))
        && esSocioPorNoche(get(/databases/$(database)/documents/properties/$(propertyId)).data);
    }
    // Permisos del socio (admin/js/permisos-socio.js): permisosSocios/{su propietarioId} lo escriben el administrador y el
    // servidor (cada hora y al marcar una comisión pagada). Sin documento, puede (así funciona antes de calcularse).
    function socioPuede(clave) {
      let ruta = /databases/$(database)/documents/permisosSocios/$(userDoc().data.get('propietarioId', '-'));
      return !exists(ruta) || get(ruta).data.get(clave, true) != false;
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function isAdmin() {
      return isStaff() && userDoc().data.rol == 'admin';
    }
    // El asesor de quien está en el panel. Uno sin asesor vinculado no coincide con nada: los registros sin asesor
    // (agentId '', p. ej. las casas por noche y sus reservas y solicitudes) son solo del administrador y del dueño.
    function myAgentId() {
      return userDoc().data.get('agentId', '') == '' ? '(sin asesor)' : userDoc().data.agentId;
    }
    function isNonEmptyString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    // Bitácora de cambios sensibles (admin/js/bitacora.js): quién, cuándo, antes y después de lo que toca dinero o al dueño.
    // El documento que cambia nombra su renglón nuevo en `bitacoraId`, en el mismo lote; el renglón (bitacora/{id}) lleva la
    // «foto» de lo sensible antes y después, que aquí se compara con lo guardado (get) y con lo que queda (getAfter).
    // Las fotos: las mismas en admin/js/bitacora.js (fotoCasa, fotoPropietario, fotoPermisos), con los mismos valores
    // por omisión. El servidor (cuenta de escritura) escribe el suyo en la misma transacción.
    function fotoCasa(p, s) {
      return { 'moneda': p.get('moneda', ''), 'propietarioId': p.get('propietarioId', ''), 'limpieza': p.get('vacacional', {}).get('limpieza', 0),
        'precioBase': s.get('precioBase', 0), 'precioFinde': s.get('precioFinde', 0), 'tarifas': s.get('tarifas', []), 'margen': s.get('margen', 20) };
    }
    function cambiaCasa(a, b) {
      return a.get('moneda', '') != b.get('moneda', '') || a.get('propietarioId', '') != b.get('propietarioId', '')
        || a.get('vacacional', {}).get('limpieza', 0) != b.get('vacacional', {}).get('limpieza', 0);
    }
    function cambiaSocio(a, b) {
      return a.get('precioBase', 0) != b.get('precioBase', 0) || a.get('precioFinde', 0) != b.get('precioFinde', 0)
        || a.get('tarifas', []) != b.get('tarifas', []) || a.get('margen', 20) != b.get('margen', 20);
    }
    function fotoPropietario(d) {
      return { 'datosPago': d.get('datosPago', ''), 'permisos': d.get('permisos', {}) };
    }
    function fotoPermisos(d) {
      return { 'precios': d.get('precios', true), 'fechas': d.get('fechas', true), 'casa': d.get('casa', true) };
    }
    // El documento que cambia nombra un renglón nuevo de la bitácora, de su tipo y de este objeto, creado en el mismo lote.
    function anotado(tipo, objeto) {
      let id = request.resource.data.get('bitacoraId', '');
      let ruta = /databases/$(database)/documents/bitacora/$(id);
      return id is string && id.size() > 0 && (resource == null || id != resource.data.get('bitacoraId', ''))
        && !exists(ruta) && getAfter(ruta).data.tipo == tipo && getAfter(ruta).data.objeto == objeto;
    }

    // Precio por noche que ve el cliente = precio del dueño × (1 + margen / 100), al centavo (js/calc-vacacional.js
    // nochePublica). Cuando el dueño cambia sus precios, el público y el suyo van juntos (una transacción en
    // «Mis propiedades») y tienen que cuadrar: así no baja su parte sin bajar la del cliente (la comisión de EQ sale
    // de su parte) ni quita el margen del precio público.
    function enBanda(publico, socio, margen) {
      return math.abs(publico - socio * (100 + margen) / 100.0) <= 0.011;
    }
    // Fin de semana: sin precio propio (0) en uno, sin precio propio en el otro.
    function findeEnBanda(publico, socio, margen) {
      return socio == 0 ? publico == 0 : enBanda(publico, socio, margen);
    }
    // Precios por fechas: la misma lista en el mismo orden, mismas fechas y cada precio en banda.
    // Las reglas no recorren listas (y cuentan cada operación): se revisan una a una, hasta 10 (el panel del dueño
    // guarda solo las que no han pasado).
    function tarifaEnBanda(p, s, margen) {
      return p.desde == s.desde && p.hasta == s.hasta && enBanda(p.precio, s.precio, margen);
    }
    function tarifasEnBanda(pub, soc, m) {
      let n = pub.size();
      return n == soc.size() && n <= 10
        && (n < 1 || tarifaEnBanda(pub[0], soc[0], m)) && (n < 2 || tarifaEnBanda(pub[1], soc[1], m))
        && (n < 3 || tarifaEnBanda(pub[2], soc[2], m)) && (n < 4 || tarifaEnBanda(pub[3], soc[3], m))
        && (n < 5 || tarifaEnBanda(pub[4], soc[4], m)) && (n < 6 || tarifaEnBanda(pub[5], soc[5], m))
        && (n < 7 || tarifaEnBanda(pub[6], soc[6], m)) && (n < 8 || tarifaEnBanda(pub[7], soc[7], m))
        && (n < 9 || tarifaEnBanda(pub[8], soc[8], m)) && (n < 10 || tarifaEnBanda(pub[9], soc[9], m));
    }
    // Lo que el dueño cambia de sus precios (en la casa o en privado/socio) cuadra con el otro documento tal como
    // queda (getAfter): solo se revisa lo que cambió, para que una casa con un precio viejo no le impida bloquear días.
    // casa / socio: los dos documentos después del cambio; cambia: los campos de precio que tocó.
    // casaAntes / socioAntes: los dos como estaban. Con más de 10 precios por fechas (de antes), el dueño solo puede
    // quitar: las dos listas quedan más cortas y con lo que ya tenían (nada nuevo ni cambiado).
    function preciosCuadran(casa, socio, cambia, casaAntes, socioAntes) {
      let v = casa.get('vacacional', {});
      let m = socio.get('margen', 20);
      return (!cambia.hasAny(['base', 'precioBase']) || enBanda(v.get('base', 0), socio.get('precioBase', 0), m))
        && (!cambia.hasAny(['finde', 'precioFinde']) || findeEnBanda(v.get('finde', 0), socio.get('precioFinde', 0), m))
        && (!cambia.hasAny(['tarifas']) || tarifasEnBanda(v.get('tarifas', []), socio.get('tarifas', []), m)
            || (quita(v.get('tarifas', []), casaAntes.get('vacacional', {}).get('tarifas', []))
                && quita(socio.get('tarifas', []), socioAntes.get('tarifas', []))));
    }
    function quita(despues, antes) {
      return despues.size() < antes.size() && antes.hasAll(despues);
    }
    // privado/socio de una casa tal como está (una casa por noche puede no tenerlo todavía: vacío, sin error).
    function socioAntes(id) {
      let ruta = /databases/$(database)/documents/properties/$(id)/privado/socio;
      return exists(ruta) ? get(ruta).data : {};
    }

    // Lo que el dueño pone en su calendario, con sus topes (los mismos de «Mis propiedades», admin/js/views/mis-casas.js):
    // personas de 1 a 50 (entero); mínimos de noches de 1 a 30, hasta 10 a la vez; días bloqueados hasta 15 grupos a la vez,
    // cada uno con fechas AAAA-MM-DD, la salida después de la llegada y a lo más hasta el fin del año dentro de 3.
    // Con más de los que caben (de antes), solo puede quitar (como los precios: quita). Las reglas no recorren listas.
    // (Cada revisión cuenta: las reglas paran en 1000 operaciones por pedido y cada dato de la lista cuesta varias. Por eso
    // solo se comparan textos —«AAAA-MM-DD» se ordena igual que la fecha: una fecha mal escrita queda fuera de los
    // límites— y los topes son los que caben, medidos en el emulador con su caso más grande en test-reglas.mjs.)
    function bloqueoSano(r, t) {
      return r.desde >= '2020-01-01' && r.desde < r.hasta && r.hasta <= t;
    }
    function minimoSano(r, t) {
      return r.desde >= '2020-01-01' && r.desde <= r.hasta && r.hasta <= t && r.noches is int && r.noches >= 1 && r.noches <= 30;
    }
    function bloqueosSanos(l, t) {
      let n = l.size();
      return n <= 15
        && (n < 1 || bloqueoSano(l[0], t)) && (n < 2 || bloqueoSano(l[1], t))
        && (n < 3 || bloqueoSano(l[2], t)) && (n < 4 || bloqueoSano(l[3], t))
        && (n < 5 || bloqueoSano(l[4], t)) && (n < 6 || bloqueoSano(l[5], t))
        && (n < 7 || bloqueoSano(l[6], t)) && (n < 8 || bloqueoSano(l[7], t))
        && (n < 9 || bloqueoSano(l[8], t)) && (n < 10 || bloqueoSano(l[9], t))
        && (n < 11 || bloqueoSano(l[10], t)) && (n < 12 || bloqueoSano(l[11], t))
        && (n < 13 || bloqueoSano(l[12], t)) && (n < 14 || bloqueoSano(l[13], t))
        && (n < 15 || bloqueoSano(l[14], t));
    }
    function minimosSanos(l, t) {
      let n = l.size();
      return n <= 10
        && (n < 1 || minimoSano(l[0], t)) && (n < 2 || minimoSano(l[1], t))
        && (n < 3 || minimoSano(l[2], t)) && (n < 4 || minimoSano(l[3], t))
        && (n < 5 || minimoSano(l[4], t)) && (n < 6 || minimoSano(l[5], t))
        && (n < 7 || minimoSano(l[6], t)) && (n < 8 || minimoSano(l[7], t))
        && (n < 9 || minimoSano(l[8], t)) && (n < 10 || minimoSano(l[9], t));
    }
    function listaSana(lista, antes, sana) {
      return lista is list && (sana || (antes is list && quita(lista, antes)));
    }
    function calendarioSano(v, antes, cambia) {
      let tope = string(request.time.year() + 3) + '-12-31';
      return (!cambia.hasAny(['huespedesMax']) || (v.huespedesMax is int && v.huespedesMax >= 1 && v.huespedesMax <= 50))
        && (!cambia.hasAny(['minimos']) || (v.minimos is list && listaSana(v.minimos, antes.get('minimos', []), minimosSanos(v.minimos, tope))))
        && (!cambia.hasAny(['bloqueos']) || (v.bloqueos is list && listaSana(v.bloqueos, antes.get('bloqueos', []), bloqueosSanos(v.bloqueos, tope))));
    }

    // Marca de que ya hay administrador. El arranque «crear el primer administrador» desde el navegador se cerró: con el
    // alta de Firebase pública, cualquiera habría podido hacerse administrador si este documento faltara. Ya nadie la
    // escribe ni la borra; un administrador nuevo lo crea otro administrador (Usuarios).
    match /meta/bootstrap {
      allow get: if true;
    }

    // Informe semanal de Search Console (netlify/functions/seo-semanal.mjs). Lo escribe el servidor; solo lo lee el
    // administrador.
    match /seoSemanal/{fecha} {
      allow read: if isAdmin();
    }

    // Estado de publicación (cambios pendientes, última publicación).
    match /meta/publish {
      allow read, write: if isStaff();
      // El socio solo deja el aviso de "hay cambios por publicar".
      allow update: if esSocio() && soloCambia(['pendiente', 'ultimoCambio', 'ultimoCambioDesc', 'ultimoCambioPor']);
    }

    // Estado del sistema (netlify/lib/estado.mjs): lo que falló y desde cuándo. Lo escribe solo el servidor, con la cuenta
    // de escritura; lo lee el administrador (la tarjeta de Inicio).
    match /estado/{pieza} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && !(uid == request.auth.uid && (request.resource.data.rol != 'admin' || request.resource.data.activo != true));
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /settings/site {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Datos internos (p. ej. el build hook de Netlify): solo el equipo.
    // Permisos de los socios para todos { precios, fechas, casa }: los cambia el administrador (Propietarios).
    match /settings/permisosSocios {
      allow get: if isAdmin();
      // Con su renglón en la bitácora si cambia un interruptor.
      allow create, update: if isAdmin()
        && (fotoPermisos(request.resource.data) == fotoPermisos(resource == null ? {} : resource.data) || anotado('permisos', 'permisosSocios'));
      // Borrarlo encendería todo para todos sin renglón: nadie lo borra (se apaga o enciende cada interruptor).
      allow delete: if false;
    }
    // Lo que puede cada socio (el resultado): lo escriben el administrador y el servidor; el socio lee el suyo. Si cambia
    // un interruptor, con su renglón en la bitácora (tipo permisosSocio); borrarlo solo si no apaga nada (sin documento,
    // todo está permitido).
    match /permisosSocios/{propietarioId} {
      allow read: if isAdmin() || (esSocio() && userDoc().data.get('propietarioId', '') == propietarioId);
      allow create, update: if isAdmin()
        && (fotoPermisos(request.resource.data) == fotoPermisos(resource == null ? {} : resource.data) || anotado('permisosSocio', propietarioId));
      allow delete: if isAdmin() && fotoPermisos(resource.data) == fotoPermisos({});
    }

    match /settings/private {
      allow get: if isStaff();
      allow write: if isAdmin();
    }

    // Regla general de comisión del CRM: la ve el equipo, la cambia el administrador.
    match /settings/crm {
      allow get: if isStaff();
      allow write: if isAdmin();
    }
    // Cotizaciones: datos de la empresa que factura, ISR %, % para el asesor, vigencia y condiciones.
    // Los lee el equipo; los cambia el administrador.
    match /settings/cotizacion {
      allow get: if isStaff();
      allow write: if isAdmin();
    }
    // Datos del asesor para facturar sus cotizaciones (NIT, régimen): los ve y cambia el asesor dueño y el administrador.
    // El id del documento es el agentId del asesor.
    match /emisoresAsesor/{agentId} {
      allow read, write: if isAdmin() || (isStaff() && myAgentId() == agentId);
    }

    match /properties/{id} {
      allow get: if resource.data.publicado == true || isStaff() || esSocioDe(resource.data);
      allow list: if resource.data.publicado == true || isStaff() || esSocioDe(resource.data);
      // Una casa por noche no lleva asesor: el asesor no crea una ni pasa la suya a por noche (solo el administrador).
      allow create: if isAdmin()
        || (isStaff() && request.resource.data.agentId == myAgentId() && request.resource.data.get('operacion', '') != 'vacacional');
      // Moneda, dueño y limpieza (cambiaCasa) van con su renglón en la bitácora (anotado). El socio no los toca (su rama
      // solo deja precios, personas y fechas): no se le revisa, así su pedido cabe en el tope de 1000 revisiones.
      allow update: if ((isStaff() && (!cambiaCasa(resource.data, request.resource.data) || anotado('casa', id))) && (isAdmin()
        || (resource.data.agentId == myAgentId() && request.resource.data.agentId == myAgentId()
            && request.resource.data.get('operacion', '') != 'vacacional')))
        // El socio solo toca precios, personas, días bloqueados y mínimos de noches de sus casas por noche (las noches
        // reservadas las escriben el administrador y el servidor: netlify/functions/reservas.mjs).
        || (esSocioPorNoche(resource.data) && request.resource.data.get('operacion', '') == 'vacacional'
            && soloCambia(['vacacional', 'precio', 'updatedAt'])
            && request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys()
                 .hasOnly(['base', 'finde', 'tarifas', 'bloqueos', 'minimos', 'huespedesMax'])
            // Lo que el administrador le apagó (o se apagó por atraso en la comisión) no lo cambia.
            && (!request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys().hasAny(['base', 'finde', 'tarifas', 'minimos', 'huespedesMax'])
              || socioPuede('precios'))
            && (!request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys().hasAny(['bloqueos']) || socioPuede('fechas'))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['precio']) || socioPuede('precios'))
            // Personas, mínimos y días bloqueados con sus topes (calendarioSano).
            && calendarioSano(request.resource.data.vacacional, resource.data.vacacional,
                 request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys())
            // Sus precios públicos cuadran con los suyos (privado/socio tal como queda en la misma transacción).
            // Solo si tocó precios: una casa sin privado/socio todavía también bloquea días.
            && (!request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys().hasAny(['base', 'finde', 'tarifas'])
              || preciosCuadran(request.resource.data,
                 getAfter(/databases/$(database)/documents/properties/$(id)/privado/socio).data,
                 request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys(),
                 resource.data, socioAntes(id))));
      allow delete: if isAdmin();

      // Bitácora de la casa: quién cambió qué y cuándo. Solo se agrega; nadie la edita ni la borra.
      // La leen y escriben el administrador, el asesor de la casa y el dueño de una casa por noche.
      function deLaBitacora() {
        let casa = get(/databases/$(database)/documents/properties/$(id)).data;
        return isAdmin() || (isStaff() && casa.get('agentId', '') == myAgentId()) || esSocioPorNoche(casa);
      }
      // El renglón del dueño dice lo que de verdad cambió en el mismo lote (antes: get; después: getAfter), no solo con la
      // forma de TEXTO_DUENO: así no anota montos que nunca existieron. Precio entre semana o de fin de semana: el de antes y
      // el de ahora de su privado/socio, al medio centavo (el texto redondea a 2 decimales), en la moneda de la casa; sin el
      // de antes, solo si era 0 o no cabe en el texto (1,000,000 o más, lo puso el equipo). Personas: las de la casa (sin
      // dato, 1, como el panel; un dato de antes fuera de 1 a 50 no se compara). Días bloqueados, precios especiales y
      // mínimos: que esa lista cambió y, con su monto o sus noches, que está en la lista nueva (las primeras 10); «puso las
      // temporadas», los precios especiales o los mínimos. El texto sin valores (el de una pestaña con las reglas de antes)
      // también tiene que nombrar algo que cambió.
      function montoDe(t) {
        return t == 'igual que entre semana' ? 0.0 : float(t.replace('^(US[$]|Q) ', '').replace(',', ''));
      }
      function enMoneda(t, moneda) {
        return t == 'igual que entre semana' || t.matches(moneda == 'GTQ' ? 'Q [0-9].*' : 'US[$] [0-9].*');
      }
      function cerca(a, b) {
        return (a is int || a is float) && (b is int || b is float) && math.abs(a - b) <= 0.0051;
      }
      function precioCuadra(que, campo, antes, despues, moneda) {
        let a = antes.get(campo, 0);
        let d = despues.get(campo, 0);
        let v = que.split(': ').size() > 1 ? que.split(': ')[1].split(' → ') : [];
        return a != d && (v.size() == 0
          || (v.size() == 1 && enMoneda(v[0], moneda) && cerca(montoDe(v[0]), d) && (a == 0 || ((a is int || a is float) && a >= 1000000)))
          || (v.size() == 2 && enMoneda(v[0], moneda) && enMoneda(v[1], moneda) && cerca(montoDe(v[0]), a) && cerca(montoDe(v[1]), d)));
      }
      function personasCuadra(que, antes, despues) {
        let a = antes.get('huespedesMax', 1);
        let d = despues.get('huespedesMax', 1);
        let p = que.split(' ');
        return a != d && int(p[p.size() - 1]) == d
          && (p.size() == 3 || int(p[2]) == a || !(a is int && a >= 1 && a <= 50));
      }
      function enLista(l, campo, v) {
        let n = l.size();
        return (n > 0 && cerca(l[0].get(campo, -1), v)) || (n > 1 && cerca(l[1].get(campo, -1), v))
          || (n > 2 && cerca(l[2].get(campo, -1), v)) || (n > 3 && cerca(l[3].get(campo, -1), v))
          || (n > 4 && cerca(l[4].get(campo, -1), v)) || (n > 5 && cerca(l[5].get(campo, -1), v))
          || (n > 6 && cerca(l[6].get(campo, -1), v)) || (n > 7 && cerca(l[7].get(campo, -1), v))
          || (n > 8 && cerca(l[8].get(campo, -1), v)) || (n > 9 && cerca(l[9].get(campo, -1), v));
      }
      function listaCuadra(que, antes, despues, campo, moneda) {
        let v = que.split(': ');
        return antes != despues && (v.size() == 1
          || (campo == 'precio' ? enMoneda(v[1], moneda) && enLista(despues, 'precio', montoDe(v[1]))
            : enLista(despues, 'noches', int(v[1].split(' ')[0]))));
      }
      function renglonCuadra(que) {
        let casa = /databases/$(database)/documents/properties/$(id);
        let socio = /databases/$(database)/documents/properties/$(id)/privado/socio;
        let va = get(casa).data.get('vacacional', {});
        let vd = getAfter(casa).data.get('vacacional', {});
        let moneda = getAfter(casa).data.get('moneda', '');
        return que.matches('precio (entre semana|fin de semana).*')
            ? precioCuadra(que, que.matches('precio entre semana.*') ? 'precioBase' : 'precioFinde', socioAntes(id),
                existsAfter(socio) ? getAfter(socio).data : {}, moneda)
          : que.matches('personas máximo.*') ? personasCuadra(que, va, vd)
          : que.matches('(bloqueó|habilitó) .*') ? va.get('bloqueos', []) != vd.get('bloqueos', [])
          : que.matches('(mínimo de noches|quitó mínimos de noches) .*') ? listaCuadra(que, va.get('minimos', []), vd.get('minimos', []), 'noches', moneda)
          // «Faltan tus temporadas» copia precios especiales, mínimos o los dos.
          : que.matches('puso las temporadas de .*') && va.get('minimos', []) != vd.get('minimos', []) ? true
          : listaCuadra(que, socioAntes(id).get('tarifas', []), existsAfter(socio) ? getAfter(socio).data.get('tarifas', []) : [], 'precio', moneda);
      }
      match /bitacora/{entrada} {
        allow read: if deLaBitacora();
        // El dueño escribe solo los textos de «Mis propiedades» (admin/js/texto-dueno.js TEXTO_DUENO, la misma expresión):
        // un texto libre podría decir «el administrador aprobó…» o llevar un teléfono; y el texto dice lo que cambió en el
        // mismo lote (renglonCuadra). Lo del servidor no pasa por aquí.
        allow create: if deLaBitacora()
          && request.resource.data.quien == request.auth.uid
          && request.resource.data.cuando == request.time
          && (isStaff() || (request.resource.data.keys().hasOnly(['que', 'quien', 'nombre', 'cuando'])
            && request.resource.data.que is string
            && request.resource.data.que.matches('(precio (entre semana|fin de semana)(: (((US[$]|Q) [0-9]{1,3}(,[0-9]{3})?([.][0-9]{1,2})?|igual que entre semana) → )?((US[$]|Q) [0-9]{1,3}(,[0-9]{3})?([.][0-9]{1,2})?|igual que entre semana))?|personas máximo(: [0-9]{1,2} →)? [0-9]{1,2}|puso las temporadas de [0-9]{4}|(bloqueó|habilitó) [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?( – [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?)?( [(](Otra reserva|Mantenimiento|Uso propio)[)])?( [(](cada año en estas fechas|cada año en Semana Santa)[)])?|precio especial [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?( – [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?)?( [(](Otra reserva|Mantenimiento|Uso propio)[)])?( [(](cada año en estas fechas|cada año en Semana Santa)[)])?(: (US[$]|Q) [0-9]{1,3}(,[0-9]{3})?([.][0-9]{1,2})?)?|mínimo de noches [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?( – [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?)?( [(](Otra reserva|Mantenimiento|Uso propio)[)])?( [(](cada año en estas fechas|cada año en Semana Santa)[)])?(: [0-9]{1,2} noches?)?|quitó (precios especiales|mínimos de noches) [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?( – [1-3]?[0-9]( (ene|feb|mar|abr|may|jun|jul|ago|sept|oct|nov|dic)( 20[0-9]{2})?)?)?( [(]todos los años[)])?)')
            && renglonCuadra(request.resource.data.que)));
      }

      // Lo privado de la casa: precio del socio, margen e iCal (privado/socio), dirección y mapa (llegada), acuerdo con
      // el dueño (acuerdo) y contacto del huésped de una reserva hecha a mano (reserva-{id}). Nunca es público
      // (la propiedad sí lo es). El equipo: admin o el asesor de la propiedad.
      // Precios del dueño y margen (privado/socio) de una casa que ya existía: con su renglón en la bitácora. (La casa nueva
      // con su privado, en un solo lote, no: nace así.) Sin la casa (borrada) no cambian: su renglón pide la casa.
      function socioAnotado(id) {
        return (resource == null && !exists(/databases/$(database)/documents/properties/$(id))
            && existsAfter(/databases/$(database)/documents/properties/$(id)))
          || !cambiaSocio(resource == null ? {} : resource.data, request.resource.data) || anotado('casa', id);
      }
      // Lo que el dueño cambia de su privado/socio: solo sus precios, con su renglón en la bitácora si cambian, y cuadrando
      // con los públicos. (Lo que cambió se calcula una sola vez: cada comparación de 10 precios por fechas cuenta para el
      // tope de 1000 revisiones por pedido.)
      function socioActualiza(id, cambia) {
        return cambia.hasOnly(['precioBase', 'precioFinde', 'tarifas', 'updatedAt', 'updatedBy', 'bitacoraId'])
          && (!cambia.hasAny(['precioBase', 'precioFinde', 'tarifas']) || anotado('casa', id))
          && socioPuede('precios')
          && preciosCuadran(getAfter(/databases/$(database)/documents/properties/$(id)).data, request.resource.data,
               cambia, get(/databases/$(database)/documents/properties/$(id)).data, resource.data);
      }
      match /privado/{docId} {
        // (getAfter: también en el mismo lote que crea la casa, admin/js/privado-casa.js crearCasa.)
        allow read: if isAdmin()
          || (isStaff() && get(/databases/$(database)/documents/properties/$(id)).data.agentId == myAgentId());
        allow create, update: if (isAdmin()
          || (isStaff() && getAfter(/databases/$(database)/documents/properties/$(id)).data.agentId == myAgentId()))
          && (docId != 'socio' || socioAnotado(id));
        // privado/socio (precios del dueño y margen) solo se va con la casa, en el mismo lote («Eliminar casa»): borrarlo
        // solo dejaría el margen en 20 y los precios en 0 sin renglón.
        allow delete: if (isAdmin()
          || (isStaff() && getAfter(/databases/$(database)/documents/properties/$(id)).data.agentId == myAgentId()))
          && (docId != 'socio' || !existsAfter(/databases/$(database)/documents/properties/$(id)));
        // El socio lee su privado/socio entero (sus precios, el margen y el iCal: con el margen ve lo que paga el cliente)
        // y cambia solo sus precios, siempre junto con los públicos; el margen y el iCal los pone el equipo.
        // «llegada» (dirección y mapa de una casa por noche): el socio la lee para mandarla al cliente
        // con el pago recibido; solo el equipo la escribe.
        allow get: if docId in ['socio', 'llegada'] && esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data);
        allow update: if docId == 'socio' && esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data)
          && socioActualiza(id, request.resource.data.diff(resource.data).affectedKeys());
        // Una casa por noche que todavía no tiene privado/socio: el dueño lo crea con sus precios, con las mismas
        // condiciones (el margen, que no puede poner, queda el de siempre: 20 %).
        allow create: if docId == 'socio' && esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data)
          && request.resource.data.keys().hasOnly(['precioBase', 'precioFinde', 'tarifas', 'updatedAt', 'updatedBy', 'bitacoraId'])
          && (!request.resource.data.keys().hasAny(['precioBase', 'precioFinde', 'tarifas']) || anotado('casa', id))
          && socioPuede('precios')
          && preciosCuadran(getAfter(/databases/$(database)/documents/properties/$(id)).data, request.resource.data,
               request.resource.data.keys(), get(/databases/$(database)/documents/properties/$(id)).data, {});
      }
    }

    match /agents/{id} {
      allow read: if resource.data.activo == true || isStaff();
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if resource.data.activo == true || isStaff();
      allow write: if isAdmin();
    }

    match /pages/{id} {
      allow read: if resource.data.publicado == true || isStaff();
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read: if resource.data.publicado == true || isStaff();
      allow write: if isAdmin();
    }

    // Requerimientos de clientes (búsquedas guardadas por los asesores).
    match /requerimientos/{id} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      allow create: if isStaff()
        && (isAdmin() || request.resource.data.agentId == myAgentId());
      allow update: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId()
            && request.resource.data.agentId == resource.data.agentId);
      // Una solicitud de reserva no se borra (ni el administrador): su reserva, su chat, sus plazos y sus correos la
      // buscan. Se cierra con «No se dio» o se cancela. Un lead de contacto, sí.
      allow delete: if isAdmin() && resource.data.get('reserva', {}).get('codigo', '') == '';
    }

    // CRM: clientes, actividades (agenda e historial) y propietarios.
    // El asesor solo ve y edita lo que tiene asignado; el administrador, todo.
    function propio() {
      return isAdmin() || (isStaff() && resource.data.agentId == myAgentId());
    }
    function nuevoPropio() {
      return isStaff() && (isAdmin() || request.resource.data.agentId == myAgentId());
    }
    function conservaAsesor() {
      return isAdmin() || request.resource.data.agentId == resource.data.agentId;
    }
    match /clientes/{id} {
      allow read: if propio();
      allow create: if nuevoPropio();
      allow update: if propio() && conservaAsesor();
      allow delete: if isAdmin();
    }
    match /actividades/{id} {
      allow read: if propio();
      allow create: if nuevoPropio();
      allow update: if propio() && conservaAsesor();
      allow delete: if propio();
    }
    // Datos de pago del socio (los recibe el cliente en el chat al confirmar) y sus permisos: solo el administrador los
    // cambia, y cada cambio deja su renglón en la bitácora en el mismo lote (anotado). Si cambian los datos de pago, el
    // servidor manda el correo al equipo (netlify/lib/avisos-pago.mjs) y lo marca avisado. (cambiosDatosPago: los de antes.)
    match /propietarios/{id} {
      // Solo el equipo: la ficha lleva notas, bitácora y datos internos. El dueño lee su resumen (portalPropietarios).
      allow read: if propio();
      // Los permisos del socio (permisos) y sus datos de pago los cambia solo el administrador.
      allow create: if nuevoPropio()
        && (isAdmin() || !request.resource.data.keys().hasAny(['permisos', 'datosPago', 'datosPagoCambio', 'bitacoraId']))
        && (fotoPropietario(request.resource.data) == fotoPropietario({}) || anotado('propietario', id));
      allow update: if propio() && conservaAsesor()
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permisos', 'datosPago', 'datosPagoCambio', 'bitacoraId']))
        && (fotoPropietario(request.resource.data) == fotoPropietario(resource.data) || anotado('propietario', id));
      allow delete: if isAdmin();
    }
    // Los cambios de datos de pago de antes de la bitácora: se leen (la ficha del dueño y el correo pendiente); ya no se crean.
    match /cambiosDatosPago/{cambio} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Bitácora de cambios sensibles: solo crear, con la foto de antes y de después tal como están en la base. La lee el
    // administrador. Tipos: casa (moneda, dueño, limpieza; precios del dueño y margen), propietario (datos de pago y
    // permisos), permisos (los de todos los socios), permisosSocio (lo que resulta para un socio), reserva («Revisé Airbnb…» al confirmar).
    function entradaCasa(id, d) {
      let p = /databases/$(database)/documents/properties/$(d.objeto);
      let s = /databases/$(database)/documents/properties/$(d.objeto)/privado/socio;
      return exists(p) && d.get('casa', '') == d.objeto && !('avisado' in d)
        && (isAdmin() || (isStaff() && get(p).data.get('agentId', '') == myAgentId()) || esSocioPorNoche(get(p).data))
        && d.antes == fotoCasa(get(p).data, exists(s) ? get(s).data : {})
        && d.despues == fotoCasa(getAfter(p).data, existsAfter(s) ? getAfter(s).data : {})
        && (getAfter(p).data.get('bitacoraId', '') == id || (existsAfter(s) && getAfter(s).data.get('bitacoraId', '') == id));
    }
    function entradaPropietario(id, d) {
      let r = /databases/$(database)/documents/propietarios/$(d.objeto);
      return isAdmin() && !('casa' in d)
        && d.antes == fotoPropietario(exists(r) ? get(r).data : {})
        && d.despues == fotoPropietario(getAfter(r).data)
        && getAfter(r).data.get('bitacoraId', '') == id
        && (d.antes.datosPago == d.despues.datosPago ? !('avisado' in d) : d.get('avisado', true) == false);
    }
    // Los de todos (settings/permisosSocios, objeto «permisosSocios») o lo que resulta para un socio (permisosSocios/{id}).
    function entradaPermisos(id, d, r) {
      return isAdmin() && !('casa' in d) && !('avisado' in d)
        && d.antes == fotoPermisos(exists(r) ? get(r).data : {})
        && d.despues == fotoPermisos(getAfter(r).data)
        && getAfter(r).data.get('bitacoraId', '') == id;
    }
    function entradaReserva(id, d) {
      let r = /databases/$(database)/documents/reservas/$(d.objeto);
      return isAdmin() && !exists(r) && !('avisado' in d)
        && d.get('casa', '') == getAfter(r).data.get('propertyId', '')
        && d.antes == { 'revisadoAMano': [] }
        && d.despues == { 'revisadoAMano': getAfter(r).data.get('revisadoAMano', []) }
        && getAfter(r).data.get('bitacoraId', '') == id;
    }
    match /bitacora/{entrada} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tipo', 'objeto', 'casa', 'antes', 'despues', 'quien', 'nombre', 'cuando', 'avisado'])
        && isNonEmptyString(request.resource.data.objeto, 128)
        && request.resource.data.quien == request.auth.uid
        && request.resource.data.cuando == request.time
        && isShortString(request.resource.data.get('nombre', ''), 120)
        && request.resource.data.antes is map && request.resource.data.despues is map
        && request.resource.data.antes != request.resource.data.despues
        && ((request.resource.data.tipo == 'casa' && entradaCasa(entrada, request.resource.data))
          || (request.resource.data.tipo == 'propietario' && entradaPropietario(entrada, request.resource.data))
          || (request.resource.data.tipo == 'permisos' && request.resource.data.objeto == 'permisosSocios'
            && entradaPermisos(entrada, request.resource.data, /databases/$(database)/documents/settings/permisosSocios))
          || (request.resource.data.tipo == 'permisosSocio'
            && entradaPermisos(entrada, request.resource.data, /databases/$(database)/documents/permisosSocios/$(request.resource.data.objeto)))
          || (request.resource.data.tipo == 'reserva' && entradaReserva(entrada, request.resource.data)));
      allow update, delete: if false;
    }
    // Comprobante de la comisión: la foto subida a la carpeta de esa reserva (admin/js/views/solicitudes.js). Solo del
    // almacenamiento de la empresa (las pruebas usan ese mismo nombre en el emulador): una foto alojada en otro proyecto
    // podría llevar a una página falsa.
    function comprobanteValido(url, reservaId) {
      return url is string && url.size() <= 600
        && url.matches('(https://firebasestorage[.]googleapis[.]com|http://127[.]0[.]0[.]1:9199)/v0/b/eqinmobiliariobd[.]firebasestorage[.]app/o/comprobantes%2F'
             + reservaId + '%2F[A-Za-z0-9._-]+[?]alt=media&token=[a-z0-9-]+');
    }
    // Reservas de rentas vacacionales: fechas, huésped y lo que toca al propietario.
    // Del equipo, solo el administrador las crea y cambia (Rentas y Solicitudes son suyas; una casa por noche no lleva asesor).
    // Lo que hace el socio (confirmar, cancelar) lo escribe el servidor (netlify/functions/reservas.mjs) con su cuenta de
    // servicio, que no pasa por estas reglas: los montos y las revisiones viven allí, no en el navegador del socio.
    match /reservas/{id} {
      allow read: if propio() || esSocioDe(resource.data);
      // «Revisé Airbnb…» (revisadoAMano) va con su renglón en la bitácora.
      allow create: if isAdmin() && (request.resource.data.get('revisadoAMano', []).size() == 0 || anotado('reserva', id));
      // La comisión la marca pagada solo el administrador; el socio solo le pone su comprobante.
      // «Revisé Airbnb…» queda como nació (su renglón es de la confirmación): nadie lo pone ni lo quita después.
      allow update: if (isAdmin() && request.resource.data.get('revisadoAMano', []) == resource.data.get('revisadoAMano', []))
        // El comprobante lo pone quien ganó la reserva, aunque la casa ya no sea suya (lo mismo que storage.rules).
        || (esSocioDe(resource.data) && soloCambia(['comision', 'updatedAt'])
            && request.resource.data.comision.diff(resource.data.comision).affectedKeys().hasOnly(['comprobante'])
            && comprobanteValido(request.resource.data.comision.comprobante, id));
      allow delete: if isAdmin();
    }
    // Montos de una solicitud de reserva por noche, congelados al llegar (la parte del socio, la limpieza y el margen de
    // la casa en ese momento): los escribe solo el servidor (netlify/lib/reservas-servidor.mjs congelarMontos, con la
    // cuenta de escritura, que no pasa por estas reglas). Los leen el administrador y el socio de esa casa.
    match /montosSolicitud/{id} {
      allow read: if isAdmin() || esSocioDe(resource.data);
      allow write: if false;
    }
    // Revisión del comprobante del huésped con la IA (netlify/lib/comprobantes.mjs): lo leído y si cuadra con la reserva.
    // La escribe solo el servidor; la leen el administrador y el socio de esa casa (como los montos congelados).
    match /revisionesComprobante/{id} {
      allow read: if isAdmin() || esSocioDe(resource.data);
      allow write: if false;
    }
    // Cotizaciones de servicios: cada asesor ve y edita las suyas; el administrador, todas.
    // Número seguido (COT-0001, COT-0002…): lo da el contador contadores/cotizaciones { ultimo, cotizacion }, en la misma
    // transacción que crea la cotización (admin/js/views/cotizacion.js). El contador sube de 1 en 1 y solo junto con la
    // cotización que nace con ese número; la cotización nace solo con el número que el contador le dio. Nadie lo cambia después.
    function numeroDe(n) {
      return 'COT-' + (n < 10 ? '000' : n < 100 ? '00' : n < 1000 ? '0' : '') + string(n);
    }
    function contadorCotizaciones() {
      return /databases/$(database)/documents/contadores/cotizaciones;
    }
    function contadorValido(c) {
      return c.keys().hasOnly(['ultimo', 'cotizacion']) && c.ultimo is int && c.cotizacion is string && c.cotizacion.size() > 0
        && !exists(/databases/$(database)/documents/cotizaciones/$(c.cotizacion))
        && getAfter(/databases/$(database)/documents/cotizaciones/$(c.cotizacion)).data.get('consecutivo', -1) == c.ultimo;
    }
    match /contadores/cotizaciones {
      allow get: if isStaff();
      allow create: if isStaff() && request.resource.data.get('ultimo', 0) == 1 && contadorValido(request.resource.data);
      allow update: if isStaff() && request.resource.data.get('ultimo', 0) == resource.data.ultimo + 1 && contadorValido(request.resource.data);
    }
    match /cotizaciones/{id} {
      allow read: if propio();
      allow create: if nuevoPropio()
        && request.resource.data.get('consecutivo', 0) is int
        && getAfter(contadorCotizaciones()).data.get('ultimo', -1) == request.resource.data.consecutivo
        && getAfter(contadorCotizaciones()).data.get('cotizacion', '') == id
        && request.resource.data.get('numero', '') == numeroDe(request.resource.data.consecutivo);
      allow update: if propio() && conservaAsesor()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['numero', 'consecutivo']);
      allow delete: if propio();
    }

    // Resumen del dueño (propietario o colaborador): copia sin datos de clientes, hecha por el equipo, con lo que la
    // persona necesita de su ficha (nombre, correo, teléfono, datos de pago). La lee esa persona desde su panel
    // (con su usuario) y el equipo; nadie sin sesión.
    function portalValido(token) {
      return token.size() >= 32
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.agentId is string
        && request.resource.data.propietarioId is string
        && request.resource.data.propiedades is list
        && request.resource.data.propiedades.size() <= 50;
    }
    // El asesor arma resúmenes solo de las personas que atiende (su ficha lleva su agentId).
    function fichaDelAsesor(propietarioId) {
      return isNonEmptyString(propietarioId, 128)
        && exists(/databases/$(database)/documents/propietarios/$(propietarioId))
        && get(/databases/$(database)/documents/propietarios/$(propietarioId)).data.get('agentId', '') == myAgentId();
    }
    // Los datos de pago del resumen que arma un asesor son los de la ficha (los cambia solo el administrador).
    function pagoDeLaFicha() {
      return request.resource.data.get('datosPago', '')
        == get(/databases/$(database)/documents/propietarios/$(request.resource.data.propietarioId)).data.get('datosPago', '');
    }
    function resumenPropio() {
      return esSocio() && resource.data.propietarioId == userDoc().data.propietarioId;
    }
    match /portalPropietarios/{token} {
      allow get, list: if resumenPropio()
        || isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      allow create: if isStaff() && portalValido(token)
        && (isAdmin() || (request.resource.data.agentId == myAgentId() && fichaDelAsesor(request.resource.data.propietarioId) && pagoDeLaFicha()));
      allow update: if isStaff() && portalValido(token)
        && (isAdmin() || (resource.data.agentId == myAgentId()
            && request.resource.data.agentId == myAgentId() && fichaDelAsesor(request.resource.data.propietarioId) && pagoDeLaFicha()));
      allow delete: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
    }

    // Respuesta del dueño al anuncio desde su panel: «aprobado» o «cambios» (con texto). Solo el dueño con sesión,
    // de su propio resumen y de una casa suya. Solo crear: nadie los cambia ni los borra. Los lee solo el equipo.
    function portalDelComentario() {
      return get(/databases/$(database)/documents/portalPropietarios/$(request.resource.data.token)).data;
    }
    match /comentariosPropietarios/{id} {
      allow create: if esSocio()
        && request.resource.data.keys().hasOnly([
            'token', 'propietarioId', 'agentId', 'propiedadId', 'tipo', 'texto', 'fecha', 'origen', 'idioma'])
        && request.resource.data.keys().hasAll(['token', 'propietarioId', 'agentId', 'propiedadId', 'tipo', 'texto', 'fecha', 'origen'])
        && request.resource.data.propietarioId == userDoc().data.propietarioId
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32
        && request.resource.data.token.size() <= 128
        && exists(/databases/$(database)/documents/portalPropietarios/$(request.resource.data.token))
        && portalDelComentario().propietarioId == request.resource.data.propietarioId
        && portalDelComentario().agentId == request.resource.data.agentId
        && isNonEmptyString(request.resource.data.propiedadId, 60)
        && esSocioDe(get(/databases/$(database)/documents/properties/$(request.resource.data.propiedadId)).data)
        && request.resource.data.tipo in ['aprobado', 'cambios']
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000
        // Pedir cambios exige texto; la aprobación puede ir sin texto.
        && (request.resource.data.tipo == 'aprobado' || request.resource.data.texto.size() >= 1)
        && request.resource.data.origen == 'propietario'
        && (!('idioma' in request.resource.data) || request.resource.data.idioma in ['es', 'en'])
        && request.resource.data.fecha == request.time;
      allow read: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      allow update, delete: if false;
    }

    // «Listo» de la campana de avisos (admin/js/avisos.js): alguien del equipo ya atendió un aviso que no se resuelve
    // solo. La clave dice cuál (avisos-reglas.js claveListo); el documento, quién y cuándo. Sin datos de clientes.
    //  - robo_{solicitud}: «No se dio» con fechas ocupadas (solo el administrador);
    //  - cambios_{comentario}: un dueño pidió cambios (el administrador o el asesor de ese dueño);
    //  - exclusiva_{casa}_{fin}: la exclusiva de una casa por vencer (el administrador o el asesor de la casa).
    // Solo crear y deshacer (borrar el suyo); nadie lo cambia después.
    function listoValido(clave) {
      let d = request.resource.data;
      return (d.tipo == 'robo' && isAdmin() && clave == 'robo_' + d.objeto && d.agentId == ''
            && !('fin' in d) && exists(/databases/$(database)/documents/leads/$(d.objeto)))
        || (d.tipo == 'cambios' && clave == 'cambios_' + d.objeto && !('fin' in d)
            && exists(/databases/$(database)/documents/comentariosPropietarios/$(d.objeto))
            && d.agentId == get(/databases/$(database)/documents/comentariosPropietarios/$(d.objeto)).data.agentId)
        || (d.tipo == 'exclusiva' && d.get('fin', '') is string && d.get('fin', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && clave == 'exclusiva_' + d.objeto + '_' + d.fin
            && exists(/databases/$(database)/documents/properties/$(d.objeto))
            && d.agentId == get(/databases/$(database)/documents/properties/$(d.objeto)).data.get('agentId', ''));
    }
    match /avisosAtendidos/{clave} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['tipo', 'objeto', 'fin', 'agentId', 'por', 'fecha'])
        && request.resource.data.keys().hasAll(['tipo', 'objeto', 'agentId', 'por', 'fecha'])
        && isNonEmptyString(request.resource.data.objeto, 150)
        && request.resource.data.agentId is string
        && (isAdmin() || request.resource.data.agentId == myAgentId())
        && request.resource.data.por == request.auth.uid
        && request.resource.data.fecha == request.time
        && listoValido(clave);
      allow update: if false;
      allow delete: if isAdmin() || (isStaff() && resource.data.por == request.auth.uid);
    }

    // «Hoy» en Guatemala (UTC−6 todo el año) como 'AAAA-MM-DD', con la hora del servidor (no la del teléfono).
    function hoyGt(diasMas) {
      let d = request.time - duration.value(6, 'h') + duration.value(diasMas * 24, 'h');
      return string(d.year()) + '-' + (d.month() < 10 ? '0' : '') + string(d.month()) + '-' + (d.day() < 10 ? '0' : '') + string(d.day());
    }
    match /leads/{id} {
      // Formularios públicos de contacto: campos fijos, tamaños limitados y fecha del servidor.
      // Una solicitud de reserva (con «reserva») no nace aquí: la crea el servidor junto con su chat y su índice, en una
      // transacción, con la prueba de «no soy un robot» y el límite por IP y por correo (netlify/functions/solicitud.mjs,
      // con la cuenta de escritura, que no pasa por estas reglas; ahí se revisa lo cotizado, las fechas y la casa).
      allow create: if request.resource.data.keys().hasOnly([
            'nombre', 'telefono', 'email', 'mensaje', 'origen', 'pagina',
            'propertyId', 'propertyTitulo', 'agentId', 'estado', 'createdAt', 'fechaVisita',
            'tipoVisita', 'idioma', 'campana'])
        && isNonEmptyString(request.resource.data.nombre, 100)
        && isNonEmptyString(request.resource.data.telefono, 30)
        && isShortString(request.resource.data.email, 120)
        && isShortString(request.resource.data.mensaje, 2000)
        && isShortString(request.resource.data.origen, 30)
        && isShortString(request.resource.data.pagina, 200)
        && isShortString(request.resource.data.propertyId, 60)
        && isShortString(request.resource.data.propertyTitulo, 200)
        && isShortString(request.resource.data.agentId, 60)
        // La fecha de visita: 'AAAA-MM-DD', de hoy a un año (js/site.js diaValido, con el reloj del teléfono). Con un día de
        // holgura a cada lado: un teléfono con el reloj corrido no se queda sin poder pedir la visita de hoy.
        && (!('fechaVisita' in request.resource.data)
            || (request.resource.data.fechaVisita is string
                && request.resource.data.fechaVisita.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
                && request.resource.data.fechaVisita >= hoyGt(-1) && request.resource.data.fechaVisita <= hoyGt(367)))
        && (!('tipoVisita' in request.resource.data) || request.resource.data.tipoVisita in ['presencial', 'videollamada'])
        && (!('idioma' in request.resource.data) || request.resource.data.idioma in ['es', 'en'])
        && (!('campana' in request.resource.data)
            || (request.resource.data.campana is map && request.resource.data.campana.size() <= 8))
        // El asesor del formulario es el de la casa; así una página publicada antes no le manda al asesor el contacto de
        // otro. Sin asesor ('') también vale: si la casa cambió de asesor y la página no se ha vuelto a publicar, el sitio
        // reintenta así (js/site.js) y la recibe el administrador.
        && (request.resource.data.propertyId == ''
            || request.resource.data.agentId == ''
            || !exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
            || request.resource.data.agentId
              == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('agentId', ''))
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.createdAt == request.time;
      // El socio NO lee la solicitud (trae el teléfono y el correo del cliente): trabaja con el chat.
      allow read: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      // La respuesta del socio la escribe el servidor (netlify/functions/reservas.mjs): él no la toca.
      allow update: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId()
            && request.resource.data.agentId == resource.data.agentId);
      // Una solicitud de reserva no se borra (ni el administrador): su reserva, su chat, sus plazos y sus correos la
      // buscan. Se cierra con «No se dio» o se cancela. Un lead de contacto, sí.
      allow delete: if isAdmin() && resource.data.get('reserva', {}).get('codigo', '') == '';
    }

    // Chat de una solicitud de reserva (cliente, socio y administrador: las casas por noche no llevan asesor, así que del
    // equipo solo entra el administrador). El id es la llave: largo y al azar,
    // viaja solo en el enlace del cliente. Aquí no hay teléfono ni correo de nadie.
    // Índice de un chat por solicitud (chatsPorSolicitud/{solicitud} → token): con él, el servidor usa EL chat de la
    // solicitud, no uno inventado. Leer uno que no existe responde «no existe» a cualquiera, y reglas/r5 da «no existe»:
    // las páginas publicadas antes de que el servidor creara las solicitudes lo consultan (así no se quedan esperando).
    // Nadie escribe en reglas/.
    match /reglas/{version} {
      // r6: las reglas con la bitácora de cambios sensibles (el panel pregunta por ella: admin/js/bitacora.js).
      allow get: if version in ['r5', 'r6'];
    }
    match /chatsPorSolicitud/{leadId} {
      // Lo crea el servidor junto con su solicitud y su chat (netlify/functions/solicitud.mjs). El administrador se lo pone a
      // un chat de antes que no lo tiene (Solicitudes, al abrirla), solo al de esa solicitud.
      allow create: if request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 20
        && isAdmin() && get(/databases/$(database)/documents/chats/$(request.resource.data.token)).data.leadId == leadId;
      allow get: if resource == null || isAdmin()
        || esSocioDeCasaPorNoche(get(/databases/$(database)/documents/chats/$(resource.data.token)).data.get('propertyId', ''));
      allow list: if isAdmin();
      allow update, delete: if false;
    }
    // <filtro-contacto> Lo escribe scripts/reglas-contacto.mjs desde js/calc-vacacional.js (FILTRO_CONTACTO): no se edita a mano.
    // Los mismos pasos que el navegador: reemplazos en orden y, entre ellos, las búsquedas («si»).
    function tieneContacto(texto) {
      let y = request.time.year();
      let anios = string(y - 2) + '|' + string(y - 1) + '|' + string(y) + '|' + string(y + 1) + '|' + string(y + 2) + '|' + string(y + 3) + '|' + string(y + 4) + '|' + string(y + 5);
      let t1 = texto.lower().replace('[­͏؜ᅟᅠ឴឵᠎​-‏‪-‮⁠-⁯︀-️﻿\\p{M}]', '').replace('[\\p{Z}\\t\\r\\n]+', ' ').replace('[аαАΑ]', 'a').replace('[еεёЕΕЁ]', 'e').replace('[оοσОΟ]', 'o').replace('[рρРΡ]', 'p').replace('[сС]', 'c').replace('[уγУ]', 'y').replace('[хχХΧ]', 'x').replace('[іιӏІΙӀİ]', 'i').replace('[јЈ]', 'j').replace('[ѕЅ]', 's').replace('[кκКΚ]', 'k').replace('[тτТΤ]', 't').replace('[νΝ]', 'v').replace('[мМΜ]', 'm').replace('[нНΗ]', 'h').replace('[вВΒ]', 'b').replace('[ԁ]', 'd').replace('[ɡ]', 'g').replace('[ΖZ]', 'z').replace('🔟', '55').replace('[0-9]o[0-9]', '555').replace('[0-9]o[0-9]', '555').replace('[0-9][ \\t]?[li][0-9]', '555').replace('[0-9][ \\t]?[li][0-9]', '555').replace('[0-9⁰⁴-⁹₀-₉][¹²³]|[¹²³][0-9⁰⁴-⁹¹²³₀-₉]', '55').replace('[0-9⁰⁴-⁹₀-₉][¹²³]|[¹²³][0-9⁰⁴-⁹¹²³₀-₉]', '55').replace('[^\\P{N}0-9²³¹]', '5');
      let t2 = t1.replace('\\b((' + anios + ')-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])|(0?[1-9]|[12][0-9]|3[01])[/.-](0?[1-9]|[12][0-9]|3[01])[/.-](' + anios + ')|2010 ?[-/,] ?2011|2011 ?[-/,] ?2012|2012 ?[-/,] ?2013|2013 ?[-/,] ?2014|2014 ?[-/,] ?2015|2015 ?[-/,] ?2016|2016 ?[-/,] ?2017|2017 ?[-/,] ?2018|2018 ?[-/,] ?2019|2019 ?[-/,] ?2020|2020 ?[-/,] ?2021|2021 ?[-/,] ?2022|2022 ?[-/,] ?2023|2023 ?[-/,] ?2024|2024 ?[-/,] ?2025|2025 ?[-/,] ?2026|2026 ?[-/,] ?2027|2027 ?[-/,] ?2028|2028 ?[-/,] ?2029|2029 ?[-/,] ?2030|2030 ?[-/,] ?2031|2031 ?[-/,] ?2032|2032 ?[-/,] ?2033|2033 ?[-/,] ?2034|2034 ?[-/,] ?2035|2035 ?[-/,] ?2036)\\b', ' x ').replace('(^|[^0-9 \\t.,;:/-]|[^0-9 \\t.,;:/-][ \\t]+|[^0-9 \\t.,;:/-]:[ \\t]*)((0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|[12][0-9]|3[01])([ \\t]+([01]?[0-9]|2[0-3]):[0-5][0-9])?|([01]?[0-9]|2[0-3]):[0-5][0-9])([ \\t]*(,|y|e|o|or|a las|a|al|at|-|–|and|to|hasta)[ \\t]*((0?[1-9]|[12][0-9]|3[01])/(0?[1-9]|[12][0-9]|3[01])([ \\t]+([01]?[0-9]|2[0-3]):[0-5][0-9])?|([01]?[0-9]|2[0-3]):[0-5][0-9])){0,11}(([.,:;!?]|\\))*[ \\t]*$|[ \\t]*[^0-9 \\t.:/-]|[.,:][^0-9])', ' x ').replace('\\b(veinte|treinta|cuarenta|cincuenta|sesenta|setenta|ochenta|noventa)[ \\t]+y[ \\t]+', '5').replace('\\b(diez|once|doce|trece|catorce|quince|dieci[a-z]+|veinte|veinti[a-z]+|treinta|cuarenta|cincuenta|sesenta|setenta|ochenta|noventa|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)\\b', '55').replace('cero|uno|dos|tres|cuatro|cinco|seis|siete|ocho|nueve|zero|one|two|three|four|five|six|seven|eight|nine', '5').replace('\\ba[ \\t]r[ \\t]r[ \\t]o[ \\t]b[ \\t]a\\b|\\b4rr0b4\\b|\\b4rr5b4\\b', ' arroba ');
      let t3 = t2.replace('\\b(referencia|ref|autorizaci[oóÓ]n|boleta|transacci[oóÓ]n|reference|transaction|authorization|confirmation|receipt)\\b[^0-9+\\n]{0,30}[0-9]{10,18}([.,]?[ \\t]*$|[ \\t]*[^0-9 \\t.,/+-]|[.,/+-][^0-9])', ' x ').replace('[ \\t]x[ \\t]', ' * ');
