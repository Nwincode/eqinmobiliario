rules_version = '2';

// Roles:
//  - admin:  todo.
//  - asesor: sus propiedades y sus leads (los que tienen su agentId).
//  - socio:  un dueño (propietario o colaborador) en su panel: su resumen y sus casas; cambia solo las de por noche.
//  - público: lee contenido publicado y puede crear leads desde los formularios.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.activo == true
        && userDoc().data.rol in ['admin', 'asesor'];
    }
    // Dueño (propietario o colaborador; rol «socio»): entra al panel solo a lo suyo, el de la ficha que le dio acceso.
    function esSocio() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.activo == true
        && userDoc().data.rol == 'socio';
    }
    function esSocioDe(casa) {
      return esSocio() && casa.get('propietarioId', '') != '' && casa.propietarioId == userDoc().data.propietarioId;
    }
    // Lo que el dueño cambia o lee en privado es solo de sus casas por noche; las de venta y renta las lleva el equipo.
    function esSocioPorNoche(casa) {
      return esSocioDe(casa) && casa.get('operacion', '') == 'vacacional';
    }
    // Lo mismo, por el id de la casa (reservas, solicitudes y chats llevan el propertyId).
    function esSocioDeCasaPorNoche(propertyId) {
      return esSocioPorNoche(get(/databases/$(database)/documents/properties/$(propertyId)).data);
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function isAdmin() {
      return isStaff() && userDoc().data.rol == 'admin';
    }
    function myAgentId() {
      return userDoc().data.agentId;
    }
    function isNonEmptyString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    // Primer administrador: solo se puede crear mientras meta/bootstrap no exista.
    match /meta/bootstrap {
      allow get: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/bootstrap)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    // Estado de publicación (cambios pendientes, última publicación).
    match /meta/publish {
      allow read, write: if isStaff();
      // El socio solo deja el aviso de "hay cambios por publicar".
      allow update: if esSocio() && soloCambia(['pendiente', 'ultimoCambio', 'ultimoCambioDesc', 'ultimoCambioPor']);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.auth.uid == uid
            && !exists(/databases/$(database)/documents/meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/meta/bootstrap)
            && request.resource.data.rol == 'admin'
            && request.resource.data.activo == true);
      allow update: if isAdmin()
        && !(uid == request.auth.uid && (request.resource.data.rol != 'admin' || request.resource.data.activo != true));
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /settings/site {
      allow get: if true;
      allow write: if isAdmin();
    }

    // Datos internos (p. ej. el build hook de Netlify): solo el equipo.
    match /settings/private {
      allow get: if isStaff();
      allow write: if isAdmin();
    }

    // Regla general de comisión del CRM: la ve el equipo, la cambia el administrador.
    match /settings/crm {
      allow get: if isStaff();
      allow write: if isAdmin();
    }
    // Cotizaciones: datos de la empresa que factura, ISR %, % para el asesor, vigencia y condiciones.
    // Los lee el equipo; los cambia el administrador.
    match /settings/cotizacion {
      allow get: if isStaff();
      allow write: if isAdmin();
    }
    // Datos del asesor para facturar sus cotizaciones (NIT, régimen): los ve y cambia el asesor dueño y el administrador.
    // El id del documento es el agentId del asesor.
    match /emisoresAsesor/{agentId} {
      allow read, write: if isAdmin() || (isStaff() && myAgentId() == agentId);
    }

    match /properties/{id} {
      allow get: if resource.data.publicado == true || isStaff() || esSocioDe(resource.data);
      allow list: if resource.data.publicado == true || isStaff() || esSocioDe(resource.data);
      allow create: if isAdmin()
        || (isStaff() && request.resource.data.agentId == myAgentId());
      allow update: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId() && request.resource.data.agentId == myAgentId())
        // El socio solo toca precios, personas, días bloqueados o reservados y mínimos de noches de sus casas por noche.
        || (esSocioPorNoche(resource.data) && request.resource.data.get('operacion', '') == 'vacacional'
            && soloCambia(['vacacional', 'precio', 'updatedAt'])
            && request.resource.data.vacacional.diff(resource.data.vacacional).affectedKeys()
                 .hasOnly(['base', 'finde', 'tarifas', 'bloqueos', 'minimos', 'reservadas', 'huespedesMax']));
      allow delete: if isAdmin();

      // Bitácora de la casa: quién cambió qué y cuándo. Solo se agrega; nadie la edita ni la borra.
      match /bitacora/{entrada} {
        allow read: if isStaff() || esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data);
        allow create: if (isStaff() || esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data))
          && request.resource.data.quien == request.auth.uid
          && request.resource.data.cuando == request.time;
      }

      // Renta vacacional: costo del socio, margen, contacto y enlace iCal. Nunca es público
      // (la propiedad sí lo es). Solo el equipo: admin o el asesor de la propiedad.
      match /privado/{docId} {
        allow read, write: if isAdmin()
          || (isStaff() && get(/databases/$(database)/documents/properties/$(id)).data.agentId == myAgentId());
        // El socio ve y cambia sus precios netos; nunca el margen, el contacto ni el iCal.
        // «llegada» (dirección y mapa de una casa por noche): el socio la lee para mandarla al cliente
        // con el pago recibido; solo el equipo la escribe.
        allow get: if docId in ['socio', 'llegada'] && esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data);
        allow update: if docId == 'socio' && esSocioPorNoche(get(/databases/$(database)/documents/properties/$(id)).data)
          && soloCambia(['precioBase', 'precioFinde', 'tarifas', 'updatedAt', 'updatedBy']);
      }
    }

    match /agents/{id} {
      allow read: if resource.data.activo == true || isStaff();
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if resource.data.activo == true || isStaff();
      allow write: if isAdmin();
    }

    match /pages/{id} {
      allow read: if resource.data.publicado == true || isStaff();
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read: if resource.data.publicado == true || isStaff();
      allow write: if isAdmin();
    }

    // Requerimientos de clientes (búsquedas guardadas por los asesores).
    match /requerimientos/{id} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      allow create: if isStaff()
        && (isAdmin() || request.resource.data.agentId == myAgentId());
      allow update: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId()
            && request.resource.data.agentId == resource.data.agentId);
      allow delete: if isAdmin();
    }

    // CRM: clientes, actividades (agenda e historial) y propietarios.
    // El asesor solo ve y edita lo que tiene asignado; el administrador, todo.
    function propio() {
      return isAdmin() || (isStaff() && resource.data.agentId == myAgentId());
    }
    function nuevoPropio() {
      return isStaff() && (isAdmin() || request.resource.data.agentId == myAgentId());
    }
    function conservaAsesor() {
      return isAdmin() || request.resource.data.agentId == resource.data.agentId;
    }
    match /clientes/{id} {
      allow read: if propio();
      allow create: if nuevoPropio();
      allow update: if propio() && conservaAsesor();
      allow delete: if isAdmin();
    }
    match /actividades/{id} {
      allow read: if propio();
      allow create: if nuevoPropio();
      allow update: if propio() && conservaAsesor();
      allow delete: if propio();
    }
    match /propietarios/{id} {
      // Solo el equipo: la ficha lleva notas, bitácora y datos internos. El dueño lee su resumen (portalPropietarios).
      allow read: if propio();
      allow create: if nuevoPropio();
      allow update: if propio() && conservaAsesor();
      allow delete: if isAdmin();
    }
    // Reservas de rentas vacacionales: fechas, huésped y lo que toca al propietario.
    match /reservas/{id} {
      allow read: if propio() || esSocioDe(resource.data);
      // El socio crea la reserva al confirmar una solicitud de su casa y solo puede cancelarla, con motivo.
      allow create: if nuevoPropio()
        || (esSocioDe(request.resource.data) && request.resource.data.estado == 'confirmada'
            && esSocioDeCasaPorNoche(request.resource.data.propertyId));
      // La comisión la marca pagada solo el administrador; el socio solo le pone su comprobante.
      allow update: if (propio() && conservaAsesor()
            && (isAdmin() || request.resource.data.get(['comision', 'pagada'], false) == resource.data.get(['comision', 'pagada'], false)))
        || (esSocioDe(resource.data) && esSocioDeCasaPorNoche(resource.data.propertyId) && soloCambia(['estado', 'motivo', 'updatedAt'])
            && request.resource.data.estado == 'cancelada' && isNonEmptyString(request.resource.data.motivo, 100))
        || (esSocioDe(resource.data) && esSocioDeCasaPorNoche(resource.data.propertyId) && soloCambia(['comision', 'updatedAt'])
            && request.resource.data.comision.diff(resource.data.comision).affectedKeys().hasOnly(['comprobante'])
            && isNonEmptyString(request.resource.data.comision.comprobante, 600));
      allow delete: if propio();
    }
    // Cotizaciones de servicios: cada asesor ve y edita las suyas; el administrador, todas.
    match /cotizaciones/{id} {
      allow read: if propio();
      allow create: if nuevoPropio();
      allow update: if propio() && conservaAsesor();
      allow delete: if propio();
    }

    // Resumen del dueño (propietario o colaborador): copia sin datos de clientes, hecha por el equipo, con lo que la
    // persona necesita de su ficha (nombre, correo, teléfono, datos de pago). La lee esa persona desde su panel
    // (con su usuario) y el equipo; nadie sin sesión.
    function portalValido(token) {
      return token.size() >= 32
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.agentId is string
        && request.resource.data.propietarioId is string
        && request.resource.data.propiedades is list
        && request.resource.data.propiedades.size() <= 50;
    }
    function resumenPropio() {
      return esSocio() && resource.data.propietarioId == userDoc().data.propietarioId;
    }
    match /portalPropietarios/{token} {
      allow get, list: if resumenPropio()
        || isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      allow create: if isStaff() && portalValido(token)
        && (isAdmin() || request.resource.data.agentId == myAgentId());
      allow update: if isStaff() && portalValido(token)
        && (isAdmin() || (resource.data.agentId == myAgentId()
            && request.resource.data.agentId == myAgentId()));
      allow delete: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
    }

    // Respuesta del dueño al anuncio desde su panel: «aprobado» o «cambios» (con texto). Solo el dueño con sesión,
    // de su propio resumen y de una casa suya. Solo crear: nadie los cambia ni los borra. Los lee solo el equipo.
    function portalDelComentario() {
      return get(/databases/$(database)/documents/portalPropietarios/$(request.resource.data.token)).data;
    }
    match /comentariosPropietarios/{id} {
      allow create: if esSocio()
        && request.resource.data.keys().hasOnly([
            'token', 'propietarioId', 'agentId', 'propiedadId', 'tipo', 'texto', 'fecha', 'origen', 'idioma'])
        && request.resource.data.keys().hasAll(['token', 'propietarioId', 'agentId', 'propiedadId', 'tipo', 'texto', 'fecha', 'origen'])
        && request.resource.data.propietarioId == userDoc().data.propietarioId
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32
        && request.resource.data.token.size() <= 128
        && exists(/databases/$(database)/documents/portalPropietarios/$(request.resource.data.token))
        && portalDelComentario().propietarioId == request.resource.data.propietarioId
        && portalDelComentario().agentId == request.resource.data.agentId
        && isNonEmptyString(request.resource.data.propiedadId, 60)
        && esSocioDe(get(/databases/$(database)/documents/properties/$(request.resource.data.propiedadId)).data)
        && request.resource.data.tipo in ['aprobado', 'cambios']
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 2000
        // Pedir cambios exige texto; la aprobación puede ir sin texto.
        && (request.resource.data.tipo == 'aprobado' || request.resource.data.texto.size() >= 1)
        && request.resource.data.origen == 'propietario'
        && (!('idioma' in request.resource.data) || request.resource.data.idioma in ['es', 'en'])
        && request.resource.data.fecha == request.time;
      allow read: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      allow update, delete: if false;
    }

    match /leads/{id} {
      // Formularios públicos: campos fijos, tamaños limitados y fecha del servidor.
      allow create: if request.resource.data.keys().hasOnly([
            'nombre', 'telefono', 'email', 'mensaje', 'origen', 'pagina',
            'propertyId', 'propertyTitulo', 'agentId', 'estado', 'createdAt', 'fechaVisita',
            'tipoVisita', 'idioma', 'campana', 'reserva', 'propietarioId'])
        && isNonEmptyString(request.resource.data.nombre, 100)
        && isNonEmptyString(request.resource.data.telefono, 30)
        && isShortString(request.resource.data.email, 120)
        && isShortString(request.resource.data.mensaje, 2000)
        && isShortString(request.resource.data.origen, 30)
        && isShortString(request.resource.data.pagina, 200)
        && isShortString(request.resource.data.propertyId, 60)
        && isShortString(request.resource.data.propertyTitulo, 200)
        && isShortString(request.resource.data.agentId, 60)
        && (!('fechaVisita' in request.resource.data) || isShortString(request.resource.data.fechaVisita, 20))
        && (!('tipoVisita' in request.resource.data) || request.resource.data.tipoVisita in ['presencial', 'videollamada'])
        && (!('idioma' in request.resource.data) || request.resource.data.idioma in ['es', 'en'])
        && (!('campana' in request.resource.data)
            || (request.resource.data.campana is map && request.resource.data.campana.size() <= 8))
        && (!('reserva' in request.resource.data)
            || (request.resource.data.reserva is map && request.resource.data.reserva.size() <= 10))
        // El socio de la solicitud tiene que ser el dueño real de la casa.
        && (!('propietarioId' in request.resource.data) || request.resource.data.propietarioId
            == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('propietarioId', ''))
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.createdAt == request.time;
      // El socio NO lee la solicitud (trae el teléfono y el correo del cliente): trabaja con el chat.
      allow read: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId());
      // El socio solo responde la solicitud; no cambia nada más ni la borra.
      allow update: if isAdmin()
        || (isStaff() && resource.data.agentId == myAgentId()
            && request.resource.data.agentId == resource.data.agentId)
        || (esSocioDe(resource.data) && esSocioDeCasaPorNoche(resource.data.propertyId) && soloCambia(['solicitud', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Chat de una solicitud de reserva (cliente, socio y equipo). El id es la llave: largo y al azar,
    // viaja solo en el enlace del cliente. Aquí no hay teléfono ni correo de nadie.
    match /chats/{token} {
      // Quien tiene el enlace lo abre; nadie de fuera puede listar las conversaciones.
      allow get: if true;
      allow list: if isStaff() || esSocioDe(resource.data);
      allow create: if token.size() >= 20
        && request.resource.data.keys().hasOnly(['codigo', 'propertyId', 'propertyTitulo', 'propietarioId', 'nombre',
            'llegada', 'salida', 'noches', 'huespedes', 'total', 'moneda', 'idioma', 'foto', 'url', 'leadId', 'createdAt'])
        // La conversación es de una solicitud que existe, con ese mismo código.
        && get(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.reserva.codigo == request.resource.data.codigo
        && isShortString(request.resource.data.get('foto', ''), 500)
        && isShortString(request.resource.data.get('url', ''), 200)
        && isNonEmptyString(request.resource.data.codigo, 20)
        && isNonEmptyString(request.resource.data.propertyId, 60)
        && isShortString(request.resource.data.propertyTitulo, 200)
        && isShortString(request.resource.data.nombre, 40)
        && isNonEmptyString(request.resource.data.llegada, 10)
        && isNonEmptyString(request.resource.data.salida, 10)
        && request.resource.data.noches is number && request.resource.data.huespedes is number
        && request.resource.data.total is number && isShortString(request.resource.data.moneda, 3)
        && request.resource.data.idioma in ['es', 'en']
        // El socio de la conversación es el dueño real de la casa.
        && request.resource.data.propietarioId
            == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('propietarioId', '')
        && request.resource.data.createdAt == request.time;
      // Al responder la solicitud, el equipo o el socio de la casa marcan el estado que ve el cliente; nada más.
      allow update: if isAdmin()
        || (isStaff() && soloCambia(['estado']) && request.resource.data.estado in ['confirmada', 'pagada', 'no', 'cancelada'])
        // El socio solo avanza: pendiente → confirmada o no; confirmada → pagada o cancelada.
        // Con el pago recibido ya no cancela (eso anularía la comisión): lo hace el administrador.
        || (esSocioDe(resource.data) && esSocioDeCasaPorNoche(resource.data.propertyId) && soloCambia(['estado'])
            && ((resource.data.get('estado', '') == '' && request.resource.data.estado in ['confirmada', 'no'])
              || (resource.data.get('estado', '') == 'confirmada' && request.resource.data.estado in ['pagada', 'cancelada'])))
        // «Visto»: cada quien marca solo el suyo, con la hora del servidor.
        || (!signedIn() && soloCambia(['vistoCliente']) && request.resource.data.vistoCliente == request.time)
        || (esSocioDe(resource.data) && esSocioDeCasaPorNoche(resource.data.propertyId) && soloCambia(['vistoSocio']) && request.resource.data.vistoSocio == request.time)
        || (isStaff() && soloCambia(['vistoEquipo']) && request.resource.data.vistoEquipo == request.time);
      allow delete: if isAdmin();

      match /mensajes/{id} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(token)).data;
        }
        // Quien tiene el enlace lee la conversación; el socio, solo la de sus casas.
        allow read: if !signedIn() || isStaff() || (esSocioDe(chat()) && esSocioDeCasaPorNoche(chat().propertyId));
        // Cada quien firma como lo que es: sin sesión es el cliente; el socio, solo en sus casas.
        // Sin teléfonos, correos ni enlaces (js/calc-vacacional.js hace el filtro fino; esto es el piso).
        // Mensajes con «tipo» (sin texto libre de quien los manda):
        //  - pago: los datos de pago del socio tal como los guardó el administrador (al confirmar la reserva);
        //  - llegada: lleva la dirección y el mapa tal como están guardados en privado en la casa (al recibir el pago);
        //  - foto: el comprobante del cliente, subido a la carpeta de su reserva.
        function llegadaDe() {
          return /databases/$(database)/documents/properties/$(chat().propertyId)/privado/llegada;
        }
        function sinLlegada() {
          return !request.resource.data.keys().hasAny(['direccion', 'mapa']);
        }
        allow create: if request.resource.data.keys().hasOnly(['de', 'texto', 'tipo', 'createdAt', 'direccion', 'mapa'])
          && isNonEmptyString(request.resource.data.texto, 1000)
          && (('tipo' in request.resource.data)
            ? ((request.resource.data.tipo == 'pago' && request.resource.data.de != 'cliente' && sinLlegada()
                  && request.resource.data.texto == get(/databases/$(database)/documents/propietarios/$(chat().propietarioId)).data.datosPago)
                // La dirección se muestra solo con el pago recibido.
                || (request.resource.data.tipo == 'llegada' && request.resource.data.de != 'cliente' && request.resource.data.texto == 'llegada'
                  && chat().get('estado', '') == 'pagada'
                  // Ni un carácter distinto de lo guardado: así el socio no cuela su contacto en la dirección.
                  && (exists(llegadaDe())
                    ? (request.resource.data.keys().hasAll(['direccion', 'mapa'])
                        && request.resource.data.direccion == get(llegadaDe()).data.get('direccion', '')
                        && request.resource.data.mapa == get(llegadaDe()).data.get('mapa', ''))
                    : sinLlegada()))
                || (request.resource.data.tipo == 'foto' && request.resource.data.de == 'cliente' && sinLlegada()
                  && request.resource.data.texto.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[a-z0-9.-]+/o/chats%2F' + token + '%2F[A-Za-z0-9._-]+[?]alt=media&token=[a-z0-9-]+')))
            : (sinLlegada() && !request.resource.data.texto.matches('(?s).*(@|https?:|www[.]|([0-9][ .+()-]{0,2}){8,}).*')))
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.de == 'cliente' && !signedIn())
            || (request.resource.data.de == 'equipo' && isStaff())
            // En una reserva que no se dio o se canceló, el socio ya no escribe (el equipo sí).
            || (request.resource.data.de == 'socio' && esSocioDe(chat()) && esSocioDeCasaPorNoche(chat().propertyId) && !(chat().get('estado', '') in ['no', 'cancelada'])));
        // Nada se edita ni se borra: la conversación es el registro.
        allow update, delete: if false;
      }
    }
  }
}
