rules_version = '2';

// Fotos públicas (cada una por su dirección), menos los comprobantes (fotosChat/, chats/ y comprobantes/: solo el servidor). Subir, cambiar o borrar las fotos del sitio: solo el equipo (administrador
// o asesor activo; un dueño con acceso al panel no es del equipo; las de una propiedad, el administrador o su asesor);
// listar, solo el administrador. Los comprobantes tienen su regla:
// se suben una vez y nadie los cambia ni los borra desde el panel. Máx. 10 MB por foto (5 MB los comprobantes).
service firebase.storage {
  match /b/{bucket}/o {
    function usuario() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function conSesion() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && usuario().activo == true;
    }
    function isStaff() {
      return conSesion() && usuario().rol in ['admin', 'asesor'];
    }
    function foto(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    // Comprobante de pago que el cliente adjunta en el chat de su reserva: en la carpeta de su solicitud (no cambia cuando
    // cambia el enlace: netlify/lib/rotar-enlace.mjs no mueve archivos), con nombre 1 a 10 (a lo más diez por enlace; con
    // cada enlace nuevo, `gen` del chat, la cuenta vuelve a empezar: {gen}-1 … {gen}-10,
    // sin reemplazar ni borrar), solo fotos de hasta 5 MB, con la reserva confirmada (hay a quién pagar) y con el enlace
    // vigente de esa solicitud en sus datos (`token`): solo lo sube quien tiene el enlace de hoy.
    match /fotosChat/{leadId}/{archivo} {
      allow create: if resource == null
        && archivo.matches((firestore.get(/databases/(default)/documents/chats/$(request.resource.metadata.get('token', '-'))).data.get('gen', 0) == 0 ? ''
            : string(firestore.get(/databases/(default)/documents/chats/$(request.resource.metadata.get('token', '-'))).data.get('gen', 0)) + '-') + '(10|[1-9])')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.get('token', '') is string && request.resource.metadata.get('token', '').size() >= 20
        && firestore.get(/databases/(default)/documents/chatsPorSolicitud/$(leadId)).data.token == request.resource.metadata.token
        && firestore.get(/databases/(default)/documents/chats/$(request.resource.metadata.token)).data.get('estado', '') == 'confirmada';
    }
    // La carpeta de antes (chats/{token}/): ya nadie sube ahí; lo que queda lo pasa la migración (scripts/migrar-chats.mjs).

    // Comprobante de la comisión que el dueño (socio) le paga a EQ, en la carpeta de SU reserva
    // (admin/js/views/solicitudes.js). Solo se agrega: nadie lo reemplaza ni lo borra.
    match /comprobantes/{reservaId}/{archivo} {
      allow create: if resource == null
        // Como lo prepara el panel (admin/js/imagen.js: JPG, PNG o WebP) y lo que /api/foto sirve (5 MB).
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && conSesion() && usuario().rol == 'socio'
        && firestore.get(/databases/(default)/documents/reservas/$(reservaId)).data.get('propietarioId', '') == usuario().get('propietarioId', '-');
    }

    // Cada foto se abre con su dirección, menos los comprobantes (del chat y de la comisión): los sirve solo el servidor
    // (/api/foto, netlify/functions/foto.mjs), según quién lo pide y lo que vio la revisión; aquí nadie lo abre ni ve sus
    // datos (que traen el token de descarga). La lista de archivos solo la ve el administrador (los nombres de las carpetas
    // de los chats son la llave de cada reserva; el panel no lista).
    match /{archivo} {
      allow get: if true;
      allow list: if conSesion() && usuario().rol == 'admin';
    }
    match /{carpeta}/{resto=**} {
      allow get: if !(carpeta in ['chats', 'fotosChat', 'comprobantes']);
      allow list: if conSesion() && usuario().rol == 'admin';
    }
    // Las fotos del sitio (contenido, asesores…), cada una en su carpeta: el equipo.
    // Las de una propiedad y los comprobantes (chats, comprobantes), solo con su regla.
    match /{carpeta}/{resto=**} {
      allow write: if isStaff() && !(carpeta in ['chats', 'fotosChat', 'comprobantes', 'properties'])
        && (request.resource == null || foto(10));
    }
    // Fotos de una propiedad: el administrador o el asesor de esa casa. La ficha sube las fotos de una casa nueva antes
    // de crearla (properties.js, importar.js): en una carpeta de una casa que todavía no existe sube cualquier asesor.
    // Un asesor sin asesor vinculado no coincide con nada (lo mismo que myAgentId en firestore.rules).
    match /properties/{casa}/{resto=**} {
      allow write: if isStaff() && (request.resource == null || foto(10))
        && (usuario().rol == 'admin'
          || !firestore.exists(/databases/(default)/documents/properties/$(casa))
          || firestore.get(/databases/(default)/documents/properties/$(casa)).data.get('agentId', '')
             == (usuario().get('agentId', '') == '' ? '(sin asesor)' : usuario().agentId));
    }
    // El dueño de una casa por noche sube fotos nuevas de SU casa (admin/js/views/mis-casas.js → «La casa»). Solo
    // agrega: no reemplaza ni borra (el administrador puede deshacer su cambio y volver a las de antes).
    // Y el socio sube las de SU casa nueva antes de que exista (la ficha en «Mis propiedades» → «Agregar casa»): solo en la
    // carpeta que el servidor le apartó a él (casasNuevas/{casa}, netlify/functions/mi-casa-nueva.mjs), nunca en la de
    // una casa que ya existe ni en una que nadie apartó; con nombre 1 a 40 (a lo más 40 fotos, sin reemplazar), mientras
    // la carpeta esté vigente (7 días, lo mismo que el servidor) y tenga «Ingresar inmuebles». Las vencidas sin casa las
    // barre el control de cada hora (netlify/lib/casas-nuevas.mjs).
    match /properties/{casa}/{archivo} {
      allow create: if resource == null && foto(10)
        && conSesion() && usuario().rol == 'socio'
        && (firestore.exists(/databases/(default)/documents/properties/$(casa))
          ? firestore.get(/databases/(default)/documents/properties/$(casa)).data.get('operacion', '') == 'vacacional'
            && firestore.get(/databases/(default)/documents/properties/$(casa)).data.get('propietarioId', '') == usuario().get('propietarioId', '-')
          : archivo.matches('([1-9]|[1-3][0-9]|40)[.](webp|jpg|png)')
            && firestore.exists(/databases/(default)/documents/casasNuevas/$(casa))
            && firestore.get(/databases/(default)/documents/casasNuevas/$(casa)).data.get('propietarioId', '') == usuario().get('propietarioId', '-')
            && firestore.get(/databases/(default)/documents/casasNuevas/$(casa)).data.cuando + duration.value(7, 'd') > request.time
            && (!firestore.exists(/databases/(default)/documents/permisosSocios/$(usuario().get('propietarioId', '-')))
              || firestore.get(/databases/(default)/documents/permisosSocios/$(usuario().get('propietarioId', '-'))).data.get('inmuebles', true) != false));
    }
  }
}
