rules_version = '2';

// Fotos públicas (cada una por su dirección). Subir, cambiar o borrar las fotos del sitio: solo el equipo (administrador
// o asesor activo; un dueño con acceso al panel no es del equipo; las de una propiedad, el administrador o su asesor);
// listar, solo el administrador. Los comprobantes tienen su regla:
// se suben una vez y nadie los cambia ni los borra desde el panel. Máx. 10 MB por foto (5 MB los del cliente).
service firebase.storage {
  match /b/{bucket}/o {
    function usuario() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function conSesion() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && usuario().activo == true;
    }
    function isStaff() {
      return conSesion() && usuario().rol in ['admin', 'asesor'];
    }
    function foto(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Comprobante de pago que el cliente adjunta en el chat de su reserva: solo fotos, hasta 5 MB,
    // en la carpeta de una conversación que existe, y sin reemplazar ni borrar las que ya subió.
    match /chats/{token}/{archivo} {
      allow create: if resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && firestore.exists(/databases/(default)/documents/chats/$(token));
    }

    // Comprobante de la comisión que el dueño (socio) le paga a EQ, en la carpeta de SU reserva
    // (admin/js/views/solicitudes.js). Solo se agrega: nadie lo reemplaza ni lo borra.
    match /comprobantes/{reservaId}/{archivo} {
      allow create: if resource == null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
        && conSesion() && usuario().rol == 'socio'
        && firestore.get(/databases/(default)/documents/reservas/$(reservaId)).data.get('propietarioId', '') == usuario().get('propietarioId', '-');
    }

    match /{allPaths=**} {
      // Cada foto se abre con su dirección; la lista de archivos solo la ve el administrador
      // (los nombres de las carpetas de los chats son la llave de cada reserva; el panel no lista).
      allow get: if true;
      allow list: if conSesion() && usuario().rol == 'admin';
    }
    // Las fotos del sitio (contenido, asesores…), cada una en su carpeta: el equipo.
    // Las de una propiedad y los comprobantes (chats, comprobantes), solo con su regla.
    match /{carpeta}/{resto=**} {
      allow write: if isStaff() && !(carpeta in ['chats', 'comprobantes', 'properties'])
        && (request.resource == null || foto(10));
    }
    // Fotos de una propiedad: el administrador o el asesor de esa casa. La ficha sube las fotos de una casa nueva antes
    // de crearla (properties.js, importar.js): en una carpeta de una casa que todavía no existe sube cualquier asesor.
    // Un asesor sin asesor vinculado no coincide con nada (lo mismo que myAgentId en firestore.rules).
    match /properties/{casa}/{resto=**} {
      allow write: if isStaff() && (request.resource == null || foto(10))
        && (usuario().rol == 'admin'
          || !firestore.exists(/databases/(default)/documents/properties/$(casa))
          || firestore.get(/databases/(default)/documents/properties/$(casa)).data.get('agentId', '')
             == (usuario().get('agentId', '') == '' ? '(sin asesor)' : usuario().agentId));
    }
  }
}
